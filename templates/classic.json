{
  "id": "classic",
  "name": "Classic",
  "description": "One column, serif type, centred header and small-caps headings over a hairline rule.",
  "targetPages": 1,
  "layout": {
    "page": { "margins": { "top": 18, "right": 20, "bottom": 18, "left": 20 } },
    "grid": { "columns": [{ "id": "main", "width": 1 }], "gutter": 8, "headerSpan": "full" },
    "header": { "align": "center" },
    "theme": {
      "fontBody": "transitional", "fontHeading": "transitional",
      "sizeName": 26, "sizeSection": 12.5, "sizeEntry": 10.5, "sizeBody": 10, "sizeSmall": 9,
      "lineHeight": 1.35, "gapParagraph": 1.2, "gapEntry": 3, "gapSection": 5.5,
      "colorText": "#1c1917", "colorMuted": "#57534e", "colorAccent": "#1c1917", "colorRule": "#a8a29e",
      "colorHeading": "text", "headingCase": "small-caps", "headingLetterSpacing": 0.06, "headingWeight": 600,
      "headingRule": "below", "nameWeight": 600, "bulletChar": "•", "dateStyle": "right", "linkStyle": "plain"
    },
    "decor": []
  },
  "sectionDefaults": {}
}
