{
  "id": "academic",
  "name": "Academic",
  "description": "One serif column with dates in the left margin, the classic CV layout for research and teaching.",
  "targetPages": 1,
  "layout": {
    "page": { "margins": { "top": 15, "right": 20, "bottom": 14, "left": 20 } },
    "grid": { "columns": [{ "id": "main", "width": 1 }], "gutter": 8, "headerSpan": "full" },
    "header": { "align": "left" },
    "theme": {
      "fontBody": "old-style", "fontHeading": "old-style",
      "sizeName": 20, "sizeSection": 11.5, "sizeEntry": 10, "sizeBody": 9.75, "sizeSmall": 8.5,
      "lineHeight": 1.28, "gapParagraph": 0.9, "gapEntry": 2.2, "gapSection": 3.6,
      "colorText": "#1a1a1a", "colorMuted": "#4a4a4a", "colorAccent": "#7f1d1d", "colorRule": "#c9b8b8",
      "colorHeading": "accent", "headingCase": "none", "headingLetterSpacing": 0, "headingWeight": 700,
      "headingRule": "above", "nameWeight": 700, "bulletChar": "–", "dateStyle": "left", "linkStyle": "underline"
    },
    "decor": []
  },
  "sectionDefaults": {
    "languages": { "variant": "grid" }
  }
}
